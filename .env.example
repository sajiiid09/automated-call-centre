# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://acc:acc@localhost:5433/callcentre

# Twilio (Phase 3+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # E.164, e.g. +44xxxxxxxxxx

# AI providers (Phase 3+)
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# Public HTTPS base URL for Twilio webhooks (ngrok, Phase 3+)
# Must start with https:// — it is rewritten to wss:// for the media stream.
PUBLIC_BASE_URL=

# --- Real PSTN dialing (Phase 6) ---
# auto = real dialing once Twilio + PUBLIC_BASE_URL are set, else simulated.
# Set to "simulated" as a kill switch that forces browser web-calls.
DIALER_MODE=auto

# REQUIRED for real dialing — fail-closed. Comma-separated E.164 numbers that
# campaigns and /api/calls/outbound are allowed to call. While empty, every
# real call is refused. Keep it to your own verified numbers when testing.
OUTBOUND_ALLOWLIST=

# Blast-radius cap on real outbound calls per rolling 24h.
MAX_OUTBOUND_CALLS_PER_DAY=20

# --- Knowledge base (Phase 7) ---
# OpenAI-compatible embeddings endpoint. Do NOT name this key EMBEDDING_MODEL —
# pydantic-settings is case-insensitive and would bind this URL to the field
# that holds the model name.
EMBEDDING_API_URL=https://your-embeddings-host/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=

# Must match app.models.EMBEDDING_DIM, which is baked into the vector(N) column
# by the Alembic migration. Changing it needs a migration, not just an edit here
# — the app refuses to start if the two disagree.
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=10

# Hard budget for the per-turn knowledge lookup during a live call. On timeout
# the turn falls through to the LLM; the audio pipeline never stalls on the KB.
KB_TURN_TIMEOUT_SECONDS=0.8
KB_MAX_UPLOAD_BYTES=5242880

# Seeds for a new agent_profile row. Live values are edited on /knowledge.
FAQ_THRESHOLD=0.82
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
