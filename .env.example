# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://acc:acc@localhost:5433/callcentre

# Twilio (Phase 3+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # E.164, e.g. +44xxxxxxxxxx

# AI providers (Phase 3+)
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# Public HTTPS base URL for Twilio webhooks (ngrok, Phase 3+)
# Must start with https:// — it is rewritten to wss:// for the media stream.
PUBLIC_BASE_URL=

# --- Real PSTN dialing (Phase 6) ---
# auto = real dialing once Twilio + PUBLIC_BASE_URL are set, else simulated.
# Set to "simulated" as a kill switch that forces browser web-calls.
DIALER_MODE=auto

# REQUIRED for real dialing — fail-closed. Comma-separated E.164 numbers that
# campaigns and /api/calls/outbound are allowed to call. While empty, every
# real call is refused. Keep it to your own verified numbers when testing.
OUTBOUND_ALLOWLIST=

# Blast-radius cap on real outbound calls per rolling 24h.
MAX_OUTBOUND_CALLS_PER_DAY=20
